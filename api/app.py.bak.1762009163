# api/app.py
import os, re, json, uuid, pickle, subprocess, shlex, time
from typing import List, Optional, Dict, Any

import numpy as np
import requests
from fastapi import FastAPI, UploadFile, File, Form
from pydantic import BaseModel
from sentence_transformers import SentenceTransformer

# Optional PDF support
from pypdf import PdfReader

# --------- Env ---------
MODEL_NAME = os.getenv("MODEL_NAME", "mistral:7b-instruct")
EMBEDDING_MODEL = os.getenv("EMBEDDING_MODEL", "sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2")
TOP_K = int(os.getenv("TOP_K", 4))
MAX_CTX_TOKENS = int(os.getenv("MAX_CTX_TOKENS", 4096))

OLLAMA_URL = os.getenv("OLLAMA_URL", "http://ollama:11434")
VECTOR_DIR = os.getenv("VECTOR_DIR", "./vectorstore")
DOCS_DIR = os.getenv("DOCS_DIR", "./data/docs")

INDEX_PATH = os.path.join(VECTOR_DIR, "index.faiss")
META_PATH = os.path.join(VECTOR_DIR, "meta.pkl")

ALLOW_TOOLS = os.getenv("ALLOW_TOOLS", "0") == "1"
TOOLS = set([t.strip() for t in os.getenv("TOOLS", "").split(",") if t.strip()])
FLUXION_BIN = os.getenv("FLUXION_BIN", "fluxion_runner.py")

os.makedirs(VECTOR_DIR, exist_ok=True)

# --------- Chunking ---------
def chunk_text(text: str, size: int = 700, overlap: int = 120) -> List[str]:
    chunks = []
    start = 0
    while start < len(text):
        end = min(start + size, len(text))
        chunk = text[start:end]
        if len(chunk.strip()) > 50:
            chunks.append(chunk)
        start += size - overlap
        if start <= 0:
            break
    return chunks

def extract_text_from_pdf(path: str) -> str:
    try:
        reader = PdfReader(path)
        out = []
        for page in reader.pages:
            out.append(page.extract_text() or "")
        return "\n".join(out)
    except Exception as e:
        return ""

# --------- Vector Store (RAM + rebuild on load) ---------
class VectorStore:
    def __init__(self, embed_model_name: str):
        self.model = SentenceTransformer(embed_model_name)
        self.dim = self.model.get_sentence_embedding_dimension()
        self.texts: List[str] = []
        self.ids: List[str] = []
        self.vecs: Optional[np.ndarray] = None

    def _embed(self, texts: List[str]) -> np.ndarray:
        vecs = self.model.encode(texts, normalize_embeddings=True, show_progress_bar=False)
        return np.array(vecs, dtype=np.float32)

    def add_texts(self, texts: List[str], ids: Optional[List[str]] = None):
        if ids is None:
            ids = [str(uuid.uuid4()) for _ in texts]
        new_vecs = self._embed(texts)
        self.texts.extend(texts)
        self.ids.extend(ids)
        if self.vecs is None:
            self.vecs = new_vecs
        else:
            self.vecs = np.vstack([self.vecs, new_vecs])

    def search(self, query: str, k: int = 4):
        if self.vecs is None or len(self.vecs) == 0:
            return []
        qv = self._embed([query])[0]
        sims = (self.vecs @ qv)
        idxs = np.argsort(-sims)[:k]
        results = [(self.ids[i], self.texts[i], float(sims[i])) for i in idxs]
        return results

    def save(self):
        import faiss  # lazy import
        if self.vecs is None or len(self.vecs) == 0:
            return
        index = faiss.IndexFlatIP(self.vecs.shape[1])
        index.add(self.vecs)
        faiss.write_index(index, INDEX_PATH)
        with open(META_PATH, "wb") as f:
            pickle.dump({"ids": self.ids, "texts": self.texts}, f)

    def load(self):
        import faiss
        if not (os.path.exists(INDEX_PATH) and os.path.exists(META_PATH)):
            return False
        index = faiss.read_index(INDEX_PATH)
        with open(META_PATH, "rb") as f:
            meta = pickle.load(f)
        self.ids = meta["ids"]
        self.texts = meta["texts"]
        # Recompute embeddings to mirror what's inside FAISS (simple but RAM-heavy)
        self.vecs = self._embed(self.texts)
        return True

store = VectorStore(EMBEDDING_MODEL)
store.load()

# --------- FastAPI ---------
app = FastAPI(title="Turkai API", version="0.2")

SYSTEM_PROMPT = (
    "Sen Turkai'sin — Türkiye odaklı, Türkçe konuşan, RAG destekli bir yapay zekâ yardımcısın. "
    "Yanıtların net, teknik olarak doğru ve bağlam temelli olsun. "
    "Bilmediğin bir konuda uydurma; bağlam dışıysa açıkça söyle. "
    "Gerektiğinde adım adım açıkla. "
)

# Simple tool-calling protocol with <toolcall>{json}</toolcall> blocks
TOOL_GUIDE = (
    "Eğer görev quantum/kuantum hesaplama (örn. Bell durumu, MaxCut) gerektiriyorsa ve araç kullanımı açıksa, "
    "yalnızca aşağıdaki biçimde tek bir satır üret:\n"
    "<toolcall>{\"tool\": \"qiskit.bell\", \"args\": {}}\n"
    "veya\n"
    "<toolcall>{\"tool\": \"qiskit.maxcut\", \"args\": {\"n\": 4, \"edges\": [[0,1],[1,2],[2,3],[3,0]]}}\n"
    "Fluxion koşumu için:\n"
    "<toolcall>{\"tool\": \"fluxion.run\", \"args\": {\"script\": \"examples/hello.flx\", \"flags\": \"-v\"}}\n"
    "Araç kullanılmayacaksa doğal dil yanıtla."
)

class Message(BaseModel):
    role: str
    content: str

class ChatRequest(BaseModel):
    messages: List[Message]
    top_k: Optional[int] = None

def ollama_chat(messages: List[Dict[str, str]], stream: bool=False) -> Dict[str, Any]:
    payload = {
        "model": MODEL_NAME,
        "messages": messages,
        "stream": stream
    }
    r = requests.post(f"{OLLAMA_URL}/api/chat", json=payload, timeout=600)
    r.raise_for_status()
    return r.json()

def build_prompt(user_msg: str, retrieved: List[Any]) -> List[Dict[str, str]]:
    context_block = "\n\n".join([
        f"[Belge {i+1}] (benzerlik={sim:.3f})\n{txt}"
        for i, (_, txt, sim) in enumerate(retrieved)
    ]) if retrieved else "(bağlam yok)"
    user = (
        f"Soru: {user_msg}\n\n"
        f"Bağlam:\n{context_block}\n\n"
        f"Talimat: Yukarıdaki bağlamı mümkün olduğunca kullanarak Türkçe cevap ver. "
        f"Bağlam yetersizse belirt. "
        f"{'Araç kullanımı serbest. ' + TOOL_GUIDE if ALLOW_TOOLS else ''}"
    )
    return [
        {"role": "system", "content": SYSTEM_PROMPT},
        {"role": "user", "content": user},
    ]

TOOLCALL_RE = re.compile(r"<toolcall>\s*(\{.*?\})\s*", re.DOTALL)

# --------- Tools ---------
def tool_qiskit_bell() -> Dict[str, Any]:
    """
    Returns measurement counts for a Bell state on local simulator.
    """
    try:
        from qiskit import QuantumCircuit
        from qiskit_aer import Aer
        from qiskit import transpile
    except Exception as e:
        return {"ok": False, "error": f"Qiskit import failed: {e}"}
    try:
        qc = QuantumCircuit(2, 2)
        qc.h(0)
        qc.cx(0,1)
        qc.measure([0,1],[0,1])
        backend = Aer.get_backend("aer_simulator")
        tqc = transpile(qc, backend)
        result = backend.run(tqc, shots=1024).result()
        counts = result.get_counts()
        return {"ok": True, "counts": counts}
    except Exception as e:
        return {"ok": False, "error": str(e)}

def tool_qiskit_maxcut(n: int, edges: List[List[int]]) -> Dict[str, Any]:
    """
    Tiny MaxCut with a naive brute-force to keep deps minimal; QAOA demo optional.
    """
    import itertools
    try:
        import networkx as nx  # just for convenience
    except Exception:
        nx = None

    # Score function
    def cut_value(bitstring: List[int], edges: List[List[int]]) -> int:
        val = 0
        for u, v in edges:
            if bitstring[u] != bitstring[v]:
                val += 1
        return val

    best = {"value": -1, "bitstring": None}
    for bits in itertools.product([0,1], repeat=n):
        val = cut_value(bits, edges)
        if val > best["value"]:
            best = {"value": val, "bitstring": list(bits)}
    return {"ok": True, "solution": best}

def tool_fluxion_run(script: str, flags: str="") -> Dict[str, Any]:
    """
    Run Fluxion CLI if available. Safe stub: timeouts & sanitized flags.
    """
    # Only allow -s, -v, --config minimal sample
    allowed = {"-s", "-v", "--config"}
    safe_flags = []
    for tok in shlex.split(flags):
        if tok in allowed or tok.startswith(("--config=", "-s=")):
            safe_flags.append(tok)
    cmd_list = []
    # Prefer Python runner if available
    if os.path.exists(FLUXION_BIN) or shutil.which(FLUXION_BIN):
        cmd_list = [FLUXION_BIN, "-s", script] + safe_flags
    else:
        # try python -m if provided path
        if os.path.exists(script):
            cmd_list = ["python3", script] + safe_flags
        else:
            return {"ok": False, "error": "Fluxion binary not found; mount or set FLUXION_BIN."}
    try:
        proc = subprocess.run(cmd_list, timeout=30, capture_output=True, text=True)
        return {
            "ok": proc.returncode == 0,
            "returncode": proc.returncode,
            "stdout": proc.stdout[-2000:],
            "stderr": proc.stderr[-2000:],
            "cmd": " ".join(shlex.quote(x) for x in cmd_list)
        }
    except subprocess.TimeoutExpired:
        return {"ok": False, "error": "Fluxion run timeout (30s)"}
    except Exception as e:
        return {"ok": False, "error": str(e)}

# Dispatcher
def dispatch_tool(tool: str, args: Dict[str, Any]) -> Dict[str, Any]:
    if tool not in TOOLS:
        return {"ok": False, "error": f"Tool not allowed: {tool}"}
    if tool == "qiskit.bell":
        return tool_qiskit_bell()
    if tool == "qiskit.maxcut":
        n = int(args.get("n", 4))
        edges = args.get("edges", [[0,1],[1,2],[2,3],[3,0]])
        return tool_qiskit_maxcut(n, edges)
    if tool == "fluxion.run":
        return tool_fluxion_run(args.get("script", ""), args.get("flags", ""))
    return {"ok": False, "error": f"Unknown tool: {tool}"}

# --------- Routes ---------
@app.get("/")
def root():
    return {"name": "Turkai API", "model": MODEL_NAME, "tools_enabled": ALLOW_TOOLS, "tools": sorted(list(TOOLS))}

@app.post("/ingest")
async def ingest(files: List[UploadFile] = File(default=[])):
    texts = []
    if files:
        for f in files:
            raw = await f.read()
            name = f.filename or "upload"
            # Try pdf
            if name.lower().endswith(".pdf"):
                tmp = f"/tmp/{uuid.uuid4().hex}.pdf"
                with open(tmp, "wb") as fh:
                    fh.write(raw)
                pdf_text = extract_text_from_pdf(tmp)
                if pdf_text:
                    texts.extend(chunk_text(pdf_text))
                os.remove(tmp)
            else:
                try:
                    text = raw.decode("utf-8", errors="ignore")
                except Exception:
                    text = str(raw)
                texts.extend(chunk_text(text))
    else:
        # scan folder
        for name in os.listdir(DOCS_DIR):
            p = os.path.join(DOCS_DIR, name)
            if not os.path.isfile(p):
                continue
            if name.lower().endswith(".pdf"):
                pdf_text = extract_text_from_pdf(p)
                if pdf_text:
                    texts.extend(chunk_text(pdf_text))
            elif any(name.lower().endswith(ext) for ext in [".txt", ".md"]):
                with open(p, "r", encoding="utf-8", errors="ignore") as fh:
                    texts.extend(chunk_text(fh.read()))
    if not texts:
        return {"ok": False, "msg": "Metin bulunamadı (.txt/.md/.pdf yükleyin veya data/docs'a koyun)."}
    store.add_texts(texts)
    store.save()
    return {"ok": True, "chunks": len(texts)}

@app.post("/chat")
async def chat(req: ChatRequest):
    user_msg = ""
    for m in reversed(req.messages):
        if m.role == "user":
            user_msg = m.content
            break
    k = req.top_k or TOP_K
    retrieved = store.search(user_msg, k=k)

    # First pass
    msgs = build_prompt(user_msg, retrieved)
    data = ollama_chat(msgs, stream=False)
    content = data["choices"][0]["message"]["content"] if "choices" in data else data.get("message", "")

    # Try to parse toolcall
    tool_result = None
    if ALLOW_TOOLS:
        m = TOOLCALL_RE.search(content or "")
        if m:
            try:
                payload = json.loads(m.group(1))
                tool = payload.get("tool", "")
                args = payload.get("args", {})
                tool_result = dispatch_tool(tool, args)
                # Second pass: summarize tool result
                msgs2 = msgs + [
                    {"role": "assistant", "content": content},
                    {"role": "user", "content": f"Araç çıktısı:\n{json.dumps(tool_result, ensure_ascii=False)}\nBunu sade bir Türkçe açıklamayla özetle ve bağlamla ilişkilendir."}
                ]
                data2 = ollama_chat(msgs2, stream=False)
                content = data2["choices"][0]["message"]["content"] if "choices" in data2 else data2.get("message", content)
            except Exception as e:
                tool_result = {"ok": False, "error": f"Tool parse/exec failed: {e}"}

    return {
        "answer": content,
        "docs": [
            {"id": _id, "similarity": sim, "preview": txt[:250]}
            for _id, txt, sim in retrieved
        ],
        "tool_result": tool_result,
    }

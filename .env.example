# Turkai v0.2
MODEL_NAME=mistral:7b-instruct
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
TOP_K=4
MAX_CTX_TOKENS=4096

# Optional tool-calling
ALLOW_TOOLS=1
TOOLS=qiskit.bell,qiskit.maxcut,fluxion.run
OLLAMA_URL=http://ollama:11434

# Paths (inside container)
VECTOR_DIR=./vectorstore
DOCS_DIR=./data/docs

# Fluxion CLI (if available inside API container or mounted in PATH)
FLUXION_BIN=fluxion_runner.py
